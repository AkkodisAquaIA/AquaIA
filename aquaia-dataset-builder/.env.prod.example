# Example production environment file — not needed for default deployment.
# All required values are already set in docker-compose.prod.yml.
#
# Override here only if you need custom values, then reference this file:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Restrict CORS to a specific server URL (optional — default allows all)
# CORS_ORIGINS=["http://192.168.1.100"]

# Expose on a non-standard port instead of 80
# HTTP_PORT=8080
