# deploy/.env.example
#
# Template for the Compose stack environment file.
# Copy this file as `.env` next to docker-compose.yml in each stack directory
# on the VM (paths are stored in the GitHub Repository Variables
# STACK_DIR_STAGING / STACK_DIR_PROD; the actual values live in the private
# Akkodis ops wiki). Example:
#
#   cp deploy/.env.example <STACK_DIR_STAGING>/.env
#   cp deploy/.env.example <STACK_DIR_PROD>/.env
#
# The CI/CD pipeline rewrites IMAGE_TAG on every deploy. The other variables
# are set once at provisioning time and rarely change.
#
# NEVER commit a populated .env. Both `.env` and `deploy/.env` are gitignored.

# ---------------------------------------------------------------------------
# Image tag deployed on this stack.
#   - staging stack: rewritten to `dev-<git-sha>` by cd-staging.yml on every
#                    push to development.
#   - prod stack:    rewritten to `vX.Y.Z` by cd-prod.yml on every git tag.
# To roll back, set this to a previous tag and `docker compose pull && up -d`.
# ---------------------------------------------------------------------------
IMAGE_TAG=dev-replace-me

# ---------------------------------------------------------------------------
# Stack name. Drives the AQUAIA_STACK env var inside containers and the
# `aquaia-${STACK_NAME}` container_name suffixes. MUST be `staging` or `prod`.
# ---------------------------------------------------------------------------
STACK_NAME=staging

# ---------------------------------------------------------------------------
# Docker Hub namespace where the image is published. Replace with your actual
# namespace (the same value stored in the GitHub Repository Variable
# DOCKERHUB_NAMESPACE used by the workflows).
# ---------------------------------------------------------------------------
DOCKERHUB_NAMESPACE=your-dockerhub-namespace
